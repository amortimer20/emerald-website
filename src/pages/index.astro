---
// The landing page, in the Art Deco theme (public/mockups/deco.html). It stands
// outside Starlight's layout, like a poster in the lobby, and is always dark.
// Both examples were run with the emerald binary; keep them in step with it.
import gem from '../assets/emerald-deco.svg';
import { FONTS } from '../fonts.mjs';
import '../styles/fonts.css';

const program = `<span class="kw">struct</span> <span class="ty">Gem</span> {
    <span class="kw">const</span> name: <span class="ty">String</span>
    <span class="kw">const</span> carats: <span class="ty">Float</span>
}

<span class="kw">const</span> gems = [<span class="ty">Gem</span>(<span class="str">"Emerald"</span>, <span class="num">2.5</span>), <span class="ty">Gem</span>(<span class="str">"Ruby"</span>, <span class="num">1.25</span>)]
<span class="kw">for</span> gem <span class="kw">in</span> gems {
    <span class="fn">print</span>(<span class="str">"#{gem.name}: #{gem.carats} carats"</span>)
}`;

const output = `Emerald: 2.5 carats
Ruby: 1.25 carats`;

const diagnostic = `game.em:2:7: [E1001] \`scroe\` is not defined
  print(scroe + 1)
<span class="caret">        ^^^^^</span>
<span class="help">Check the spelling, or declare
it before this line.</span>`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Emerald — a language for learning to program</title>
		<meta name="description" content="A programming language for learning to program." />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href={FONTS} />
	</head>
	<body>
		<nav>
			<a class="brand" href="/"><img src={gem.src} width="22" height="28" alt="" /><span>Emerald</span></a>
			<div class="links"><a href="/about/">About</a><a href="/install/">Install</a><a href="/docs/language/">Docs</a></div>
		</nav>

		<header class="hero">
			<img class="gem" src={gem.src} width="130" height="169" alt="" />
			<h1>EMERALD</h1>
			<p class="tagline">A language for learning to program</p>
			<p class="sub">
				Clear code that reads like what it does, and errors that explain themselves. Built for the classroom, from
				the first <code>print</code> to the first class.
			</p>
			<div class="actions">
				<a class="button primary" href="/docs/language/the-first-program/">Get started</a>
				<a class="button" href="/install/">Install</a>
			</div>
		</header>

		<div class="divider"></div>

		<section>
			<h2>Reads like what it does</h2>
			<p class="section-sub">No ceremony before the first line. Types when they help, never when they don't.</p>
			<div class="showcase">
				<div class="frame">
					<span class="label">gems.em</span>
					<pre set:html={program} />
					<div class="output"><b>Output</b><pre set:html={output} /></div>
				</div>
				<div class="frame">
					<span class="label">When it goes wrong</span>
					<pre set:html={diagnostic} />
					<p class="aside-note">
						Every problem says what went wrong, where, and what to try, before the program ever runs.
					</p>
				</div>
			</div>
		</section>

		<div class="divider"></div>

		<section>
			<h2>Cut for the classroom</h2>
			<p class="section-sub">
				A small language with room to grow, so what a student learns in one chapter still holds in the next.
			</p>
			<div class="pillars">
				<div class="pillar">
					<div class="numeral">I</div>
					<h3>Clear</h3>
					<p>One readable way to write each idea, kept tidy by a built-in formatter.</p>
				</div>
				<div class="pillar">
					<div class="numeral">II</div>
					<h3>Honest</h3>
					<p>Mistakes caught early and explained in plain words, with the fix in view.</p>
				</div>
				<div class="pillar">
					<div class="numeral">III</div>
					<h3>Complete</h3>
					<p>Types, classes, traits, tests, and a standard library, all when the student is ready.</p>
				</div>
			</div>
		</section>

		<footer>
			<span class="gold">◆</span>&nbsp; Emerald &nbsp;<span class="gold">◆</span>&nbsp;
			<a href="/about/">About</a> · <a href="/install/">Install</a> · <a href="/docs/language/">Docs</a>
			&nbsp;<span class="gold">◆</span>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--night: #04201a;
		--gold: #d9b45a;
		--gold-soft: rgba(217, 180, 90, 0.35);
		--cream: #f3e8cc;
		--muted: #b9c7b8;
		color-scheme: dark;
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		background: radial-gradient(ellipse at 50% -10%, #0c4a38 0%, transparent 60%), var(--night);
		color: var(--cream);
		font: 300 18px/1.65 'Josefin Sans', sans-serif;
	}
	a {
		color: inherit;
	}
	code {
		font-family: 'JetBrains Mono', monospace;
		font-variant-ligatures: none;
		font-feature-settings: 'liga' 0, 'calt' 0;
		font-size: 0.9em;
	}

	/* Navigation */
	nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		max-width: 1100px;
		margin: 0 auto;
		padding: 22px 24px;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		font-size: 0.85rem;
	}
	nav .brand {
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--gold);
		text-decoration: none;
	}
	nav .links {
		display: flex;
		gap: 32px;
	}
	nav .links a {
		text-decoration: none;
		opacity: 0.85;
	}
	nav .links a:hover,
	nav .links a:focus-visible {
		color: var(--gold);
		opacity: 1;
	}

	/* Hero, over a sunburst */
	.hero {
		position: relative;
		text-align: center;
		padding: 40px 24px 90px;
		overflow: hidden;
	}
	.hero::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 250px;
		width: 1400px;
		height: 1400px;
		transform: translate(-50%, -50%);
		background: repeating-conic-gradient(from 0deg, var(--gold-soft) 0deg 0.6deg, transparent 0.6deg 7.5deg);
		-webkit-mask: radial-gradient(circle, #000 0 18%, transparent 55%);
		mask: radial-gradient(circle, #000 0 18%, transparent 55%);
		opacity: 0.55;
		pointer-events: none;
	}
	.hero > * {
		position: relative;
	}
	.gem {
		width: 130px;
		height: auto;
		filter: drop-shadow(0 0 30px rgba(47, 163, 122, 0.45));
	}
	h1 {
		font-family: 'Limelight', serif;
		font-weight: 400;
		font-size: clamp(3.6rem, 12vw, 7.5rem);
		line-height: 1;
		margin: 18px 0 10px;
		letter-spacing: 0.06em;
		text-shadow: 0 2px 0 #02120e, 0 0 40px rgba(217, 180, 90, 0.25);
	}
	.tagline {
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--gold);
		font-size: clamp(0.85rem, 2.4vw, 1.05rem);
		margin: 0 0 14px;
	}
	.sub {
		max-width: 560px;
		margin: 0 auto 34px;
		color: var(--muted);
	}
	.actions {
		display: flex;
		gap: 16px;
		justify-content: center;
		flex-wrap: wrap;
	}

	/* A hexagonal button. The outline is a gold hexagon with a dark one laid
	   over it, not a border: a border is a rectangle, and clipping it to a
	   hexagon leaves slivers of its sides at the left and right points. */
	.button {
		--hex: polygon(12px 0, calc(100% - 12px) 0, 100% 50%, calc(100% - 12px) 100%, 12px 100%, 0 50%);
		position: relative;
		isolation: isolate;
		display: inline-block;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-size: 0.85rem;
		text-decoration: none;
		padding: 15px 32px 13px;
		color: var(--gold);
		background: var(--gold);
		clip-path: var(--hex);
		transition: color 0.2s, background 0.2s;
	}
	.button::before {
		content: '';
		position: absolute;
		inset: 1.5px;
		z-index: -1;
		background: var(--night);
		clip-path: var(--hex);
		transition: opacity 0.2s;
	}
	.button.primary {
		color: var(--night);
	}
	.button.primary::before {
		opacity: 0;
	}
	.button:hover,
	.button:focus-visible {
		color: var(--night);
		outline: none;
	}
	.button:hover::before,
	.button:focus-visible::before {
		opacity: 0;
	}
	.button.primary:hover,
	.button.primary:focus-visible {
		background: var(--cream);
	}

	/* Chevron divider */
	.divider {
		height: 18px;
		max-width: 1100px;
		margin: 0 auto;
		background:
			linear-gradient(135deg, var(--gold) 25%, transparent 25%) -9px 0 / 18px 18px,
			linear-gradient(225deg, var(--gold) 25%, transparent 25%) -9px 0 / 18px 18px;
		opacity: 0.5;
	}

	/* Sections */
	section {
		max-width: 1100px;
		margin: 0 auto;
		padding: 80px 24px;
	}
	h2 {
		font-family: 'Limelight', serif;
		font-weight: 400;
		font-size: clamp(1.8rem, 5vw, 2.6rem);
		color: var(--gold);
		text-align: center;
		margin: 0 0 12px;
		letter-spacing: 0.04em;
	}
	.section-sub {
		text-align: center;
		color: var(--muted);
		max-width: 620px;
		margin: 0 auto 48px;
	}

	/* Framed code, with stepped gold corners */
	.showcase {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: 36px;
		align-items: start;
	}
	.frame {
		position: relative;
		min-width: 0;
		padding: 26px 26px 22px;
		background: rgba(4, 25, 20, 0.85);
		border: 1px solid var(--gold);
		outline: 1px solid var(--gold-soft);
		outline-offset: 6px;
	}
	.frame::before,
	.frame::after {
		content: '';
		position: absolute;
		width: 26px;
		height: 26px;
		border: 2px solid var(--gold);
	}
	.frame::before {
		top: -9px;
		left: -9px;
		border-right: none;
		border-bottom: none;
	}
	.frame::after {
		bottom: -9px;
		right: -9px;
		border-left: none;
		border-top: none;
	}
	.frame .label {
		display: block;
		margin: -4px 0 16px;
		padding-bottom: 10px;
		border-bottom: 1px solid var(--gold-soft);
		color: var(--gold);
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-size: 0.78rem;
	}
	pre {
		margin: 0;
		font: 400 0.92rem/1.7 'JetBrains Mono', monospace;
		font-variant-ligatures: none;
		font-feature-settings: 'liga' 0, 'calt' 0;
		overflow-x: auto;
		color: #e6ede4;
	}
	.kw {
		color: var(--gold);
	}
	.ty {
		color: #7fd6b0;
	}
	.str {
		color: #f0c9a0;
	}
	.num {
		color: #c9a5f0;
	}
	.fn {
		color: #9ec9ff;
	}
	.output {
		margin-top: 18px;
		padding-top: 14px;
		border-top: 1px dashed var(--gold-soft);
		color: var(--muted);
	}
	.output b {
		display: block;
		margin-bottom: 4px;
		color: var(--gold);
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-size: 0.75rem;
	}
	.caret {
		color: #ff9e8a;
	}
	.help {
		color: #d6e7cf;
	}
	.aside-note {
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 0.95rem;
	}

	/* Three pillars */
	.pillars {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}
	.pillar {
		text-align: center;
		padding: 34px 26px 30px;
		border-top: 3px double var(--gold);
		background: linear-gradient(180deg, rgba(15, 107, 79, 0.18), transparent);
	}
	.pillar .numeral {
		font-family: 'Limelight', serif;
		color: var(--gold);
		font-size: 2rem;
	}
	.pillar h3 {
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		margin: 8px 0 10px;
		font-size: 1rem;
	}
	.pillar p {
		color: var(--muted);
		margin: 0;
		font-size: 0.98rem;
	}

	footer {
		text-align: center;
		padding: 50px 24px 60px;
		color: var(--muted);
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-size: 0.78rem;
	}
	footer a {
		text-decoration: none;
	}
	footer a:hover,
	footer a:focus-visible {
		color: var(--gold);
	}
	footer .gold {
		color: var(--gold);
	}

	@media (max-width: 820px) {
		.showcase,
		.pillars {
			grid-template-columns: 1fr;
		}
		nav .links {
			gap: 16px;
			font-size: 0.8rem;
		}
		nav .brand span {
			display: none;
		}
	}
</style>
