{
	"name": "Emerald Deco Dark",
	"type": "dark",
	"colors": {
		"editor.background": "#031914",
		"editor.foreground": "#e6ede4",
		"editorGroupHeader.tabsBackground": "#031914",
		"tab.activeBackground": "#031914",
		"tab.activeForeground": "#d9b45a",
		"tab.activeBorderTop": "#d9b45a",
		"editor.selectionBackground": "#1d4236",
		"titleBar.activeBackground": "#062a21",
		"titleBar.activeForeground": "#d9b45a",
		"titleBar.border": "#4a4020"
	},
	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#8ea596"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.operator.word",
				"variable.language",
				"punctuation.section.interpolation",
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#d9b45a"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation"
			],
			"settings": {
				"foreground": "#b9c7b8"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"support.type",
				"entity.name.namespace",
				"storage.modifier.annotation",
				"punctuation.definition.annotation"
			],
			"settings": {
				"foreground": "#7fd6b0"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function"
			],
			"settings": {
				"foreground": "#9ec9ff"
			}
		},
		{
			"scope": [
				"string",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#f0c9a0"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language"
			],
			"settings": {
				"foreground": "#c9a5f0"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#ff9e8a"
			}
		}
	]
}
